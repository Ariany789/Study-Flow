# Desenvolvimento local: não depende de Supabase nem envia dados para fora da máquina.
DATABASE_URL=sqlite:///./studyflow.db
# O Docker sobrescreve esta URL e usa /data/studyflow.db no volume studyflow_data.
JWT_SECRET=change-this-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
